# 本地开发示例；不要把这里的默认口令用于生产。
ROLLFORGE_ENVIRONMENT=development
ROLLFORGE_DATABASE_URL=postgresql+asyncpg://rollforge:rollforge@localhost:5432/rollforge
ROLLFORGE_REDIS_URL=redis://localhost:6379/0
ROLLFORGE_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
POSTGRES_USER=rollforge
POSTGRES_PASSWORD=rollforge
POSTGRES_DB=rollforge
MINIO_ROOT_USER=rollforge
MINIO_ROOT_PASSWORD=rollforge-local-only
ROLLFORGE_API_URL=http://localhost:8000
# 控制面仅存储非敏感元数据，写接口默认关闭；不表示真实执行已开放。
ROLLFORGE_CONTROL_PLANE_WRITES_ENABLED=false
# 仅配置身份、角色和 token 的 SHA256 摘要；真实 token 不提交。
ROLLFORGE_API_CREDENTIALS=[]

# Worker 与对象存储默认关闭；真实凭证只在受保护本地环境配置。
ROLLFORGE_WORKER_RUNS_ENABLED=false
ROLLFORGE_WORKER_ALLOW_LAN_HTTP=false
ROLLFORGE_OBJECT_STORAGE_ALLOW_LOCAL_HTTP=false
ROLLFORGE_OBJECT_STORAGE_BUCKET=rollforge
