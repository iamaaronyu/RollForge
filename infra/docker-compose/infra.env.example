# Copy to /etc/rollforge/infra.env, replace both passwords with distinct random secrets, chmod 0600.
POSTGRES_USER=rollforge
POSTGRES_PASSWORD=replace-with-a-unique-random-secret-at-least-24-chars
POSTGRES_DB=rollforge
MINIO_ROOT_USER=rollforge-storage
MINIO_ROOT_PASSWORD=replace-with-another-unique-random-secret-24-chars
ROLLFORGE_POSTGRES_HOST_PORT=55432
ROLLFORGE_REDIS_HOST_PORT=56379
ROLLFORGE_MINIO_HOST_PORT=59000
ROLLFORGE_MINIO_CONSOLE_HOST_PORT=59001
