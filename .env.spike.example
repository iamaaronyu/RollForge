# Copy to .env.spike (ignored). Never commit filled-in configuration.
# The first Harness is provisional until the endpoint protocol is confirmed.
ROLLFORGE_SPIKE_AGENT=terminus-2
ROLLFORGE_SPIKE_PROTOCOL=openai-chat-completions
ROLLFORGE_SPIKE_MODEL=openai/your-serving-name
ROLLFORGE_SPIKE_MODEL_BASE_URL=https://inference.example.invalid/v1
ROLLFORGE_SPIKE_TIMEOUT_SEC=300
# Installed agents need an explicit CLI version; Terminus is pinned by Harbor.
ROLLFORGE_SPIKE_AGENT_VERSION=
E2B_DOMAIN=sandbox.example.invalid
E2B_API_KEY=
OPENAI_API_KEY=
# For claude-code, set protocol=anthropic-messages and these credentials instead:
ANTHROPIC_API_KEY=
