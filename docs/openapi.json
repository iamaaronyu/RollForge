        "type": "object"
      },
      "RenewRequest": {
        "additionalProperties": false,
        "properties": {
          "lease": {
            "$ref": "#/components/schemas/LeaseReference"
          },
          "lease_seconds": {
            "default": 60,
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Lease Seconds",
            "type": "integer"
          }
        },
        "required": [
          "lease"
        ],
        "title": "RenewRequest",
        "type": "object"
      },
      "ResultCommit": {
        "additionalProperties": false,
        "properties": {
          "failure_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FailureReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "manifest_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Manifest Digest",
            "type": "string"
          },
          "manifest_key": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Manifest Key",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/ResultOutcome"
          },
          "rewards": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rewards"
          }
        },
        "required": [
          "outcome",
          "manifest_key",
          "manifest_digest"
        ],
        "title": "ResultCommit",
        "type": "object"
      },
      "ResultOutcome": {
        "enum": [
          "SCORED",
          "RUNTIME_FAILED",
          "UNVERIFIED"
        ],
        "title": "ResultOutcome",
        "type": "string"
      },
      "RevisionRef": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "revision",
          "digest"
        ],
        "title": "RevisionRef",
        "type": "object"
      },
      "RunnableBinding": {
        "additionalProperties": false,
        "properties": {
          "agent_name": {
            "const": "claude-code",
            "default": "claude-code",
            "title": "Agent Name",
            "type": "string"
          },
          "agent_version": {
            "const": "2.1.81",
            "default": "2.1.81",
            "title": "Agent Version",
            "type": "string"
          },
          "credential_mode": {
            "const": "gateway-session",
            "default": "gateway-session",
            "title": "Credential Mode",
            "type": "string"
          },
          "model_base_url": {
            "title": "Model Base Url",
            "type": "string"
          },
          "model_name": {
            "const": "deepseek-flash",
            "default": "deepseek-flash",
            "title": "Model Name",
            "type": "string"
          },
          "protocol": {
            "const": "anthropic-messages",
            "default": "anthropic-messages",
            "title": "Protocol",
            "type": "string"
          },
          "task_archive_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Task Archive Digest",
            "type": "string"
          },
          "task_archive_key": {
            "maxLength": 512,
            "title": "Task Archive Key",
            "type": "string"
          },
          "verifier_mode": {
            "const": "separate",
            "default": "separate",
            "title": "Verifier Mode",
            "type": "string"
          }
        },
        "required": [
          "task_archive_key",
          "task_archive_digest",
          "model_base_url"
        ],
        "title": "RunnableBinding",
        "type": "object"
      },
      "StoredFile": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "path": {
            "maxLength": 768,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "size": {
            "maximum": 67108864.0,
            "minimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "path",
          "size",
          "digest"
        ],
        "title": "StoredFile",
        "type": "object"
      },
      "TrialStatus": {
        "enum": [
          "PENDING",
          "QUEUED",
          "RUNNING",
          "COMPLETED",
          "FAILED",
          "CANCELLED"
        ],
        "title": "TrialStatus",
        "type": "string"
      },
      "TrialView": {
        "additionalProperties": false,
        "properties": {
          "attempt_index": {
            "const": 0,
            "default": 0,
            "title": "Attempt Index",
            "type": "integer"
          },
          "fencing_token": {
            "minimum": 0.0,
            "title": "Fencing Token",
            "type": "integer"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultCommit"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TrialStatus"
          },
          "trial_id": {
            "format": "uuid",
            "title": "Trial Id",
            "type": "string"
          }
        },
        "required": [
          "trial_id",
          "job_id",
          "status",
          "fencing_token"
        ],
        "title": "TrialView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RollForge Hub API",
