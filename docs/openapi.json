{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ClaimRequest": {
        "additionalProperties": false,
        "properties": {
          "lease_seconds": {
            "default": 60,
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Lease Seconds",
            "type": "integer"
          }
        },
        "title": "ClaimRequest",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "UNAUTHORIZED",
          "FORBIDDEN",
          "WRITES_DISABLED",
          "NOT_FOUND",
          "LEASE_REJECTED",
          "CONFLICT",
          "INVALID_REQUEST",
          "DATABASE_UNAVAILABLE"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ExecutionSnapshot": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/RevisionRef"
          },
          "max_executions": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Executions",
            "type": "integer"
          },
          "model": {
            "$ref": "#/components/schemas/RevisionRef"
          },
          "schema_version": {
            "const": "1",
            "default": "1",
            "title": "Schema Version",
            "type": "string"
          },
          "task": {
            "$ref": "#/components/schemas/RevisionRef"
          },
          "timeout_sec": {
            "default": 300,
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Timeout Sec",
            "type": "integer"
          }
        },
        "required": [
          "task",
          "agent",
          "model"
        ],
        "title": "ExecutionSnapshot",
        "type": "object"
      },
      "FailureReason": {
        "enum": [
          "AGENT_ERROR",
          "VERIFIER_ERROR",
          "INFRA_ERROR",
          "UNVERIFIED"
        ],
        "title": "FailureReason",
        "type": "string"
      },
      "FinishRequest": {
        "additionalProperties": false,
        "properties": {
          "lease": {
            "$ref": "#/components/schemas/LeaseReference"
          },
          "result": {
            "$ref": "#/components/schemas/ResultCommit"
          }
        },
        "required": [
          "lease",
          "result"
        ],
        "title": "FinishRequest",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ExecutionSnapshot"
          }
        },
        "required": [
          "job_id",
          "snapshot"
        ],
        "title": "JobCreateRequest",
        "type": "object"
      },
      "JobView": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ExecutionSnapshot"
          },
          "trial": {
            "$ref": "#/components/schemas/TrialView"
          }
        },
        "required": [
          "job_id",
          "owner_id",
          "snapshot",
          "trial"
        ],
        "title": "JobView",
        "type": "object"
      },
      "Lease": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fencing_token": {
            "minimum": 1.0,
            "title": "Fencing Token",
            "type": "integer"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ExecutionSnapshot"
          },
          "trial_id": {
            "format": "uuid",
            "title": "Trial Id",
            "type": "string"
          },
          "worker_id": {
            "format": "uuid",
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "trial_id",
          "execution_id",
          "worker_id",
          "fencing_token",
          "expires_at",
          "snapshot"
        ],
        "title": "Lease",
        "type": "object"
      },
      "LeaseReference": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "fencing_token": {
            "minimum": 1.0,
            "title": "Fencing Token",
            "type": "integer"
          },
          "trial_id": {
            "format": "uuid",
            "title": "Trial Id",
            "type": "string"
          }
        },
        "required": [
          "trial_id",
          "execution_id",
          "fencing_token"
        ],
        "title": "LeaseReference",
        "type": "object"
      },
      "RenewRequest": {
        "additionalProperties": false,
        "properties": {
          "lease": {
            "$ref": "#/components/schemas/LeaseReference"
          },
          "lease_seconds": {
            "default": 60,
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Lease Seconds",
            "type": "integer"
          }
        },
        "required": [
          "lease"
        ],
        "title": "RenewRequest",
        "type": "object"
      },
      "ResultCommit": {
        "additionalProperties": false,
        "properties": {
          "failure_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FailureReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "manifest_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Manifest Digest",
            "type": "string"
          },
          "manifest_key": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Manifest Key",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/ResultOutcome"
          },
          "rewards": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rewards"
          }
        },
        "required": [
          "outcome",
          "manifest_key",
          "manifest_digest"
        ],
        "title": "ResultCommit",
        "type": "object"
      },
      "ResultOutcome": {
        "enum": [
          "SCORED",
          "RUNTIME_FAILED",
          "UNVERIFIED"
        ],
        "title": "ResultOutcome",
        "type": "string"
      },
      "RevisionRef": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "revision",
          "digest"
        ],
        "title": "RevisionRef",
        "type": "object"
      },
      "TrialStatus": {
        "enum": [
          "PENDING",
          "QUEUED",
          "RUNNING",
          "COMPLETED",
          "FAILED",
          "CANCELLED"
        ],
        "title": "TrialStatus",
        "type": "string"
      },
      "TrialView": {
        "additionalProperties": false,
        "properties": {
          "attempt_index": {
            "const": 0,
            "default": 0,
            "title": "Attempt Index",
            "type": "integer"
          },
          "fencing_token": {
            "minimum": 0.0,
            "title": "Fencing Token",
            "type": "integer"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultCommit"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TrialStatus"
          },
          "trial_id": {
            "format": "uuid",
            "title": "Trial Id",
            "type": "string"
          }
        },
        "required": [
          "trial_id",
          "job_id",
          "status",
          "fencing_token"
        ],
        "title": "TrialView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RollForge Hub API",
    "version": "0.1.0"
  },
