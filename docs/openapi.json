{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ApprovedJobCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "task_id": {
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "task_id"
        ],
        "title": "ApprovedJobCreateRequest",
        "type": "object"
      },
      "ApprovedTask": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "ApprovedTask",
        "type": "object"
      },
      "ApprovedTaskList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApprovedTask"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ApprovedTaskList",
        "type": "object"
      },
      "ArtifactIndex": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/StoredFile"
            },
            "title": "Files",
            "type": "array"
          },
          "result": {
            "$ref": "#/components/schemas/ResultCommit"
          }
        },
        "required": [
          "files",
          "result"
        ],
        "title": "ArtifactIndex",
        "type": "object"
      },
      "ClaimRequest": {
        "additionalProperties": false,
        "properties": {
          "lease_seconds": {
            "default": 60,
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Lease Seconds",
            "type": "integer"
          },
          "runnable_only": {
            "default": false,
            "title": "Runnable Only",
            "type": "boolean"
          }
        },
        "title": "ClaimRequest",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "UNAUTHORIZED",
          "FORBIDDEN",
          "WRITES_DISABLED",
          "NOT_FOUND",
          "LEASE_REJECTED",
          "CONFLICT",
          "INVALID_REQUEST",
          "DATABASE_UNAVAILABLE",
          "STORAGE_UNAVAILABLE"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ExecutionList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExecutionView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "ExecutionList",
        "type": "object"
      },
      "ExecutionSnapshot": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/RevisionRef"
          },
          "max_executions": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Executions",
            "type": "integer"
          },
          "model": {
            "$ref": "#/components/schemas/RevisionRef"
          },
          "runtime": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunnableBinding"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema_version": {
            "const": "1",
            "default": "1",
            "title": "Schema Version",
            "type": "string"
          },
          "task": {
            "$ref": "#/components/schemas/RevisionRef"
          },
          "timeout_sec": {
            "default": 300,
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Timeout Sec",
            "type": "integer"
          }
        },
        "required": [
          "task",
          "agent",
          "model"
        ],
        "title": "ExecutionSnapshot",
        "type": "object"
      },
      "ExecutionStatus": {
        "enum": [
          "RUNNING",
          "COMPLETED",
          "FAILED",
          "EXPIRED"
        ],
        "title": "ExecutionStatus",
        "type": "string"
      },
      "ExecutionView": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fencing_token": {
            "minimum": 1.0,
            "title": "Fencing Token",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultCommit"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ExecutionStatus"
          }
        },
        "required": [
          "execution_id",
          "fencing_token",
          "status",
          "expires_at"
        ],
        "title": "ExecutionView",
        "type": "object"
      },
      "FailureReason": {
        "enum": [
          "AGENT_ERROR",
          "VERIFIER_ERROR",
          "INFRA_ERROR",
          "UNVERIFIED"
        ],
        "title": "FailureReason",
        "type": "string"
      },
      "FinishRequest": {
        "additionalProperties": false,
        "properties": {
          "lease": {
            "$ref": "#/components/schemas/LeaseReference"
          },
          "result": {
            "$ref": "#/components/schemas/ResultCommit"
          }
        },
        "required": [
          "lease",
          "result"
        ],
        "title": "FinishRequest",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ExecutionSnapshot"
          }
        },
        "required": [
          "job_id",
          "snapshot"
        ],
        "title": "JobCreateRequest",
        "type": "object"
      },
      "JobList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/JobSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "JobList",
        "type": "object"
      },
      "JobSummary": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "trial": {
            "$ref": "#/components/schemas/TrialView"
          }
        },
        "required": [
          "job_id",
          "trial"
        ],
        "title": "JobSummary",
        "type": "object"
      },
      "JobView": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ExecutionSnapshot"
          },
          "trial": {
            "$ref": "#/components/schemas/TrialView"
          }
        },
        "required": [
          "job_id",
          "owner_id",
          "snapshot",
          "trial"
        ],
        "title": "JobView",
        "type": "object"
      },
      "Lease": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fencing_token": {
            "minimum": 1.0,
            "title": "Fencing Token",
            "type": "integer"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ExecutionSnapshot"
          },
          "trial_id": {
            "format": "uuid",
            "title": "Trial Id",
            "type": "string"
          },
          "worker_id": {
            "format": "uuid",
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "trial_id",
          "execution_id",
          "worker_id",
          "fencing_token",
          "job_id",
          "expires_at",
          "snapshot"
        ],
        "title": "Lease",
        "type": "object"
      },
      "LeaseReference": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "fencing_token": {
            "minimum": 1.0,
            "title": "Fencing Token",
            "type": "integer"
          },
          "trial_id": {
            "format": "uuid",
            "title": "Trial Id",
            "type": "string"
          }
        },
        "required": [
          "trial_id",
          "execution_id",
          "fencing_token"
